<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
    <PackageId>maifeipin.ChineseCalendar</PackageId>
    <RootNamespace>maifeipin.ChineseCalendar</RootNamespace>
    <AssemblyName>maifeipin.ChineseCalendar</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>通用中华万年历、农历、二十四节气、干支四柱、生肖星座与真太阳时核心计算类库</Description>
    <Version>1.0.1</Version>
    <Authors>maifeipin</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ChineseCalendar;Lunar;SolarTerms;BaZi;Zodiac;Horoscope;FengShui</PackageTags>
    <RepositoryUrl>https://github.com/maifeipin/maifeipin.ChineseCalendar</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" />
  </ItemGroup>

</Project>
